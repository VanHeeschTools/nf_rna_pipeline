/*
* Stub test for HLA typing. Run from the repository root:
*   nextflow run . -stub -c test/hla/stub_test.config
*
* Uses existing (dummy) bam files instead of alignment: S1 has a .bai index, S2 not.
* All other analysis modules are switched off.
*/
params {
    input          = "test/hla/samplesheet.csv"
    project_folder = "test/hla/output"
    outdir         = "test/hla/output/results"
    reference_gtf  = "test/hla/data/dummy.gtf"
    bam_files      = "test/hla/data/*.Aligned.sortedByCoord.out.bam"

    hla_typing = true

    qc               = false
    align            = false
    assembly         = false
    merge            = false
    build_annotation = false
    fusions          = false
    expression       = false

    max_cpus   = 2
    max_memory = '4.GB'
}

params {
    // Run parameters
    input = "/hpc/pmc_vanheesch/projects/Marina/dev/nf_rna_pipeline_sprint1/nf_rna_pipeline/test/documentation/test_samplesheet.csv"
    project_folder = "/hpc/pmc_vanheesch/projects/Marina/dev/nf_rna_pipeline_sprint1/"
    outdir         = "${params.project_folder}/quick_test/"

    // Toggle modules
    fusions  = false
    assembly = false
    merge    = false
    expression_mode = "sq" 

    // Optional parameters
    created_transcriptome_expression = true // Use the stringtie assembled gtf as reference transcriptome
    //sample_gtf_list   = "${params.outdir}/stringtie/gtflist.txt"
    output_basename = "test"

    // Long-read transcriptome (optional): merged with the short-read assembly when given and merge_longread = true
    //longread_gtf   = "<path to the transcriptome gtf of the nf_longread pipeline>"
    //merge_longread = true
    //end_tolerance  = 100

    // Reference parameters (optional)
    species        = "Homo_sapiens"
    genome_version = "GRCh38"
    annot_version  = "gencode_48"

    //Set paths (optional)
    resource_folder  = "/hpc/pmc_vanheesch/shared_resources"
    container_folder = "/hpc/local/Rocky8/pmc_vanheesch/singularity_images/"

    // Set reference files
    star_index_basedir      = "${params.resource_folder}/GENOMES/${params.species}.${params.genome_version}/${params.annot_version}/STAR"
    reference_gtf           = "${params.resource_folder}/GENOMES/${params.species}.${params.genome_version}/${params.annot_version}/annotation/${params.species}.${params.genome_version}.${params.annot_version}.gtf"

    reference_transcriptome = "${params.resource_folder}/GENOMES/${params.species}.${params.genome_version}/${params.annot_version}/${params.species}.${params.genome_version}.cdna.all.fa"
    //refseq_gtf              = "${resource_folder}/GENOMES/${species}.${genome_version}/${annot_version}/annotation/${species}.${genome_version}.p13"
    masked_fasta            = "${params.resource_folder}/GENOMES/${params.species}.${params.genome_version}/${params.annot_version}/${params.species}.${params.genome_version}.dna_sm.primary_assembly.fa"
    twobit                  = "${params.resource_folder}/GENOMES/${params.species}.${params.genome_version}/${params.annot_version}/${params.species}.${params.genome_version}.dna.primary_assembly.2bit"
    kallisto_index          = "${params.resource_folder}/GENOMES/${params.species}.${params.genome_version}/${params.annot_version}/kallisto/0.44/kallisto_index"
    arriba_reference        = "${params.resource_folder}/GENOMES/${params.species}.${params.genome_version}/${params.annot_version}/Arriba"

    // Salmon index for testing purposes, remove later
    //salmon_index_test = "/hpc/pmc_vanheesch/projects/evanderwerf/nf_rna_pipeline_project/salmon_index"
}

// Add general singularity run options for HPC
singularity {
    runOptions = '-B "/hpc:/hpc" --env "LC_ALL=C.UTF-8"'
}

// Set containers for each process
// Singularity (HPC) uses the images in params.container_folder, other engines (Docker, e.g. GCP) pull the image from a registry
// TODO: when pipeline is done try to create one big container
process {
    withName:fastp {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/fastp_0.23.4--hadf994f_2.sif':
                'quay.io/biocontainers/fastp:0.23.4--hadf994f_2' }"}
    }
    withName:checkStrand {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/howarewestrandedhere-1.0.1a.sif':
                'vanheeschlab/howarewestrandedhere:1.0.1a' }"}
    }
    withName:STAR {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/STAR-2.7.8a.sif':
                'mateongenaert/star:2.7.8a' }"}
    }
    withLabel:samtools {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/samtools-1.12.sif':
                'quay.io/biocontainers/samtools:1.16.1--h6899075_1' }"}
    }
    withName:stringtie {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/stringtie-3.0.sif':
                'jysgro/stringtie:3.0.0' }"}
    }
    withName:transcriptome_fasta {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/gffread-0.12.6.sif':
                'bschiffthaler/gffread:0.12.6' }"}
        containerOptions = {
            workflow.containerEngine == 'singularity' ? '' : '--entrypoint='
        }
    }
    withLabel:compareGTF {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/gffcompare-0.12.6.sif':
                'quay.io/biocontainers/gffcompare:0.12.6--h4ac6f70_2' }"}
    }
    // Python (polars, polars-bio) for filter_annotate.py and lr_sr_combine.py
    withName:filterAnnotate {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/nf_rna_seq_python-1.0.0.sif':
                'vanheeschlab/nf_rna_seq_python:1.0.0' }"}
    }
    withName:lr_sr_combine_transcriptome {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/nf_rna_seq_python-1.0.0.sif':
                'vanheeschlab/nf_rna_seq_python:1.0.0' }"}
    }
    withLabel:fusions {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/arriba-2.4.0.sif':
                'uhrigs/arriba:2.4.0' }"}
    }
    withLabel:salmon {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/salmon-1.8.0.sif':
                'combinelab/salmon:1.8.0' }"}
    }
    withLabel:salmon_tables {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/nf_rna_seq_r-1.0.0.sif':
                'evanderwerf/nf_rna_seq_r:1.0.0' }"}
    }
    withLabel:featurecounts {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/subread-2.0.2.sif':
                'nanozoo/subread:2.0.2--53f5da6' }"}
    }
    withLabel:multiqc {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/multiqc-1.30.sif':
                'evanderwerf/multiqc:1.33' }"}
    }
    // arcasHLA with built-in IMGT/HLA database, built from containers/arcashla/arcashla.def (only needed with hla_typing = true)
    // TODO: no Docker image published yet, push one and replace the placeholder name below
    withLabel:arcashla {
        container = {"${ workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container ?
            params.container_folder + '/arcas-hla_0.6.0_IMGT-3.66.0.sif':
                'vanheeschlab/arcas-hla:0.6.0_IMGT-3.66.0' }"}
    }
}

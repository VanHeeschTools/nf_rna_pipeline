/*
* Stub test for CRAM input. Run from the repository root:
*   nextflow run . -stub -c test/cram/stub_test.config
*
* The .cram and .fa files in test/cram/data are plain text files with only @SQ header
* lines, so the stub runs check the reference matching without samtools or containers.
* All analysis modules are switched off, only the input preparation is tested.
* Other samplesheets to try (both should stop with a clear error):
*   --input test/cram/samplesheet_no_match.csv
*   --input test/cram/samplesheet_wrong_reference.csv
*/
params {
    input = "test/cram/samplesheet_mixed.csv"
    project_folder = "test/cram/output"
    outdir = "test/cram/output/results"
    conversion_references = "test/cram/conversion_references.txt"
    reference_gtf = "test/cram/data/dummy.gtf"
    save_converted_fastq = true

    qc               = false
    align            = false
    assembly         = false
    merge            = false
    build_annotation = false
    fusions          = false
    expression       = false

    max_cpus   = 2
    max_memory = '4.GB'
}

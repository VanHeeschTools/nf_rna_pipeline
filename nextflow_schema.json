{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/YOUR_PIPELINE/master/nextflow_schema.json",
    "title": "nf-rna-pipeline parameters",
    "description": "Transcriptome analysis including mapping, assembly, expression quantification and fusion calling from RNA-seq short read data.",
    "type": "object",
    "defs": {
        "path_specifications": {
            "title": "Path specifications",
            "type": "object",
            "description": "Input and output path defs",
            "default": "",
            "properties": {
                "input": {
                    "type": "string",
                    "schema": "assets/schema_input.json",
                    "format": "file-path",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to comma-separated file containing information about the samples in the experiment."
                },
                "project_folder": {
                    "type": "string",
                    "description": "path to folder where outputs and logs will be stored"
                },
                "outdir": {
                    "type": "string",
                    "default": "\"${params.project_folder}/output\"",
                    "description": "name of the output folder"
                }
            },
            "required": [
                "input"
            ]
        },
        "reference_files": {
            "title": "Reference files",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "reference_gtf": {
                    "type": "string",
                    "description": "Reference annotation GTF"
                },
                "reference_transcriptome": {
                    "type": "string",
                    "description": "Reference assembly transcriptome"
                },
                "star_index_basedir": {
                    "type": "string",
                    "description": "Path to STAR index"
                },
                "refseq_gtf": {
                    "type": "string",
                    "description": "Path to refseq GTF"
                },
                "masked_fasta": {
                    "type": "string",
                    "description": "Path to masked fasta"
                },
                "species": {
                    "type": "string",
                    "description": "Species definition",
                    "default": "Homo_sapiens",
                    "hidden": true
                },
                "genome_version": {
                    "type": "string",
                    "description": "Version of the genome to use",
                    "hidden": true,
                    "default": "GRCh38"
                },
                "annot_version": {
                    "type": "string",
                    "default": "102",
                    "hidden": true
                },
                "twobit": {
                    "type": "string",
                    "description": "Path to twobit"
                },
                "kallisto_index": {
                    "type": "string",
                    "description": "Path to kallisto_index for strandedness"
                },
                "arriba_reference": {
                    "type": "string",
                    "description": "Path to pre-built arriba reference folder"
                }
            },
            "required": [
                "reference_gtf"
            ]
        },
        "modules": {
            "title": "Modules",
            "type": "object",
            "description": "Toggles for the different pipeline modules",
            "default": "",
            "properties": {
                "qc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for quality control module"
                },
                "align": {
                    "type": "boolean",
                    "default": true,
                    "description": "Toggle for alignment module"
                },
                "assembly": {
                    "type": "boolean",
                    "description": "Toggle for the assembly module",
                    "default": true
                },
                "expression": {
                    "type": "boolean",
                    "description": "Toggle for the expression module",
                    "default": true
                },
                "fusions": {
                    "type": "boolean",
                    "description": "Toggle for the fusion calling module",
                    "default": true
                },
                "merge": {
                    "type": "boolean",
                    "description": "Toggle for merging individual GTF files into a single file",
                    "default": true
                },
                "build_annotation": {
                    "type": "boolean",
                    "description": "Toggle to build custom annotation from merged GTFs",
                    "default": true
                },
                "run_mode": {
                    "type": "string",
                    "description": "Controls which modules of the RNA-seq workflow are executed. Options are 1) manual: User explicitly control modules with module toggles (qc, align, assembly, merge, fusions and expression). 2) qc: Run only the QC module and toggle the rest to false. Useful for verifying sample quality and inputs before running the full pipeline. 3. qc_restart: Resume the workflow from previously completed QC outputs,skipping the QC module. Enables downstream modules as defined in the module toggles. ",
                    "default": "manual", 
                    "allowed": ["manual", "qc", "qc_restart"]
                }
            }
        },
        "extended_pipeline_options": {
            "title": "Extended pipeline options",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "strandedness_check": {
                    "type": "integer",
                    "description": "Number of reads to use for strandedness check",
                    "default": 1000000
                },
                "store_trimmed_reads": {
                    "type": "boolean",
                    "description": "Whether to publish trimmed reads to the output folder, needed for qc_restart runs",
                    "default": true
                },
                "save_converted_fastq": {
                    "type": "boolean",
                    "description": "Whether to publish the fastq files converted from CRAM input to `{outdir}/cram_to_fastq`",
                    "default": false
                },
                "custom_annotation": {
                    "type": "string",
                    "description": "Formats for custom annotation outputs",
                    "default": "\"orfquant\""
                },
                "created_transcriptome_expression": {
                    "type": "boolean",
                    "description": "Whether to use assembled transcripts (not in the reference) for expression quantification" ,
                    "default": false
                },
                "expression_mode": {
                    "type": "string",
                    "description": "expression mode for Salmon and/or FeatureCounts  [\"sq\", \"sa\", \"sqfc\", \"safc\", \"fc\"]",
                    "default": "\"sqfc\""
                },
                "chr_exclusion_list": {
                    "type": "string",
                    "description": "List of chromosomes to exclude in transcriptome assembly",
                    "default": "assets/chr_exclusion_list.txt"
                },
                "output_basename": {
                    "type": "string",
                    "description": "Basename for the merged GTF, custom annotation files and expression tables",
                    "default": "transcriptome_full"
                },
                "min_tpm": {
                    "type": "integer",
                    "description": "Minimum TPM value to include a transcript in the assembled transcriptome",
                    "default": 1
                },
                "min_occurrence": {
                    "type": "integer",
                    "description": "Minimum occurrence to include a transcript in the assembled transcriptome",
                    "default": 1
                }
            }
        },
        "optional_path_defs": {
            "title": "Optional path defs",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "resource_folder": {
                    "type": "string",
                    "description": "path to annotation folder"
                },
                "container_folder": {
                    "type": "string",
                    "description": "path to container location"
                },
                "sample_gtf_list": {
                    "type": "string",
                    "description": "Path to file containing a list of individual sample GTFs for merging"
                },
                "conversion_references": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Text file listing candidate reference fastas for CRAM input, one path per line. Each fasta needs a .fai index. The fasta matching the sequence names and M5 checksums of each CRAM header is used, unless the samplesheet `conversion_reference` column is filled."
                },
                "strand_info": {
                    "type": "string",
                    "description": "Strandedness information if available in the format 'sample_id strand_type' and encoded as strand_type: 'rf' for forward, 'fr' for reverse' or 'unstranded'"
                },
                "bam_files": {
                    "type": "string",
                    "description": "Path to aligned bam files  (will be deprecated when input becomes available)",
                    "hidden": true
                },
                "multiqc_config": {
                    "type": "string",
                    "description": "Path to multiqc yaml config file for custom plots",
                    "default": "assets/multiqc.yaml"
                }
            }
        },
        "specs": {
            "title": "Maximum specifications for computational resources",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "max_memory": {
                    "type": "string",
                    "description": "max memory for each process"
                },
                "max_cpus": {
                    "type": "integer",
                    "description": "max cpus for each process"
                },
                "max_time": {
                    "type": "string",
                    "description": "max time for each process"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/defs/reference_files"
        },
        {
            "$ref": "#/defs/extended_pipeline_options"
        },
        {
            "$ref": "#/defs/modules"
        },
        {
            "$ref": "#/defs/path_specifications"
        },
        {
            "$ref": "#/defs/optional_path_defs"
        },
        {
            "$ref": "#/defs/specs"
        }
    ]
}